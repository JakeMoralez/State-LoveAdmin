# Panel
PANEL_BASE_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

# Bot database (read staff / access) — MUST match bot DATABASE_URL exactly (same file path)
# Check bot .env: grep DATABASE /opt/State-LoveBot/.env
BOT_DATABASE_URL=sqlite://../State-LoveBot/users.db
PANEL_DATABASE_URL=sqlite://data/panel.db

DEFAULT_SERVER_ID=30
MAIN_ADMIN_ID=0

# Discord OAuth (вход на панель)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

SESSION_SECRET=change-me-to-random-64-chars

# VK group (ссылка на бота на странице входа: vk.me/club{VK_GROUP_ID})
VK_GROUP_ID=

# VK service token for users.get (имя фамилия VK)
VK_SERVICE_TOKEN=
SLED_BOT_SECRET=
SLED_INTERNAL_URL=http://127.0.0.1:8081

# Раздел «Лидеры»: peer_id беседы «Руководство ЦА» (если не в role_chats)
# CA_LEADERSHIP_PEER_ID=2000000000
DEV_MODE=true
DEV_VK_ID=123456789
DEV_SKIP_CA=true

# Раздел «Разработка» (лог ошибок): уровень 10+ или список vk_id
# DEV_PANEL_MIN_LEVEL=10
# DEV_PANEL_VK_IDS=604562391
# DEV_ERROR_RETENTION=500
