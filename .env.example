# Panel
PANEL_BASE_URL=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=8000

# Bot database (read staff / access)
# Рядом с ботом: users.db или bot.db в папке State-LoveBot
BOT_DATABASE_URL=sqlite://../State-LoveBot/users.db
PANEL_DATABASE_URL=sqlite://data/panel.db

DEFAULT_SERVER_ID=30
MAIN_ADMIN_ID=0

# VK OAuth (standalone app)
VK_APP_ID=
VK_APP_SECRET=
VK_REDIRECT_URI=http://localhost:8000/api/auth/vk/callback

SESSION_SECRET=change-me-to-random-64-chars

# VK service token for users.get (имя фамилия VK)
VK_SERVICE_TOKEN=
SLED_BOT_SECRET=
SLED_INTERNAL_URL=http://127.0.0.1:8081

# Dev login without VK (для локальной разработки)
DEV_MODE=true
DEV_VK_ID=123456789
DEV_SKIP_CA=true

# Раздел «Разработка» (лог ошибок): уровень 10+ или список vk_id
# DEV_PANEL_MIN_LEVEL=10
# DEV_PANEL_VK_IDS=604562391
# DEV_ERROR_RETENTION=500
