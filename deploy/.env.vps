# Production VPS — /opt/State-Love-Admin + бот /opt/State-LoveBot (git)
# Бот с ручной установки: см. State-LoveBot/deploy/README.md → migrate-from-manual.sh
# Скопировать: cp deploy/.env.vps /opt/State-Love-Admin/.env
# Секреты Discord и SLED_BOT_SECRET — из Discord Developer Portal / бота

PANEL_BASE_URL=https://love.vlesnix.site
API_HOST=127.0.0.1
API_PORT=8000

# БД бота (читает staff / доступы) — тот же путь, что DATABASE_URL в /opt/State-LoveBot/.env
# Проверка: grep DATABASE /opt/State-LoveBot/.env && grep BOT_DATABASE /opt/State-Love-Admin/.env
BOT_DATABASE_URL=sqlite:////opt/State-LoveBot/bot.db
# БД панели (задачи, чеклист, логи)
PANEL_DATABASE_URL=sqlite:////opt/State-Love-Admin/data/panel.db
UPLOAD_DIR=/opt/State-Love-Admin/data/uploads

DEFAULT_SERVER_ID=30
MAIN_ADMIN_ID=604562391

# Discord OAuth — приложение в Discord Developer Portal
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://love.vlesnix.site/api/auth/discord/callback

# Сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# Тот же токен, что в боте (users.get для имён VK)
VK_SERVICE_TOKEN=

# ID группы VK (кнопка «Открыть бота» на странице входа)
VK_GROUP_ID=

# Скопировать из /opt/State-LoveBot/.env — должны совпадать!
SLED_BOT_SECRET=
SLED_INTERNAL_URL=http://127.0.0.1:8081

DEV_MODE=false
DEV_VK_ID=0
DEV_SKIP_CA=false

# Раздел «Разработка → Лог ошибок»
DEV_PANEL_VK_IDS=604562391
